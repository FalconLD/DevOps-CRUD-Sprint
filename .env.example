# Copiar a .env y completar. NO subir .env al repositorio.
# cp .env.example .env

# --- PostgreSQL (DBA define valores; Backend los consume) ---
POSTGRES_DB=visitantes
POSTGRES_USER=cci_user
POSTGRES_PASSWORD=cambiar_esta_clave_segura

# Alternativa que puede usar el Backend (opcional):
# DATABASE_URL=postgresql://cci_user:cambiar_esta_clave_segura@db:5432/visitantes

# --- Despliegue (solo referencia; los secretos reales van en GitHub Secrets) ---
# SERVER_IP=
# SERVER_USER=ubuntu
# DEPLOY_PATH=/opt/devops-crud-sprint
